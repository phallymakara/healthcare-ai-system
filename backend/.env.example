# ==============================================================================
# Healthcare AI System — Backend Environment Variables
# ==============================================================================
# Copy this file to .env and update values for your environment.
# For Docker deployment, use .env.docker instead (auto-configured).
# ==============================================================================

# Application
PROJECT_NAME="Healthcare AI System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="healthcare-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=healthcare_ai_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@127.0.0.1:5440/healthcare_ai_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# CORS (JSON array of allowed origins, or "*" for all)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Microsoft Foundry / Azure OpenAI LLM
MICROSOFT_FOUNDRY_API_KEY=your-api-key-here
MICROSOFT_FOUNDRY_BASE_URL=https://your-endpoint.services.ai.azure.com/openai/v1
MICROSOFT_FOUNDRY_MODEL=gpt-4o

# LangGraph Configuration
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres123@localhost:5440/healthcare_ai_db
LANGGRAPH_STRICT_MSGPACK=true

# Azure Blob Storage (Hospital Logos, Doctor Profiles & User Avatars)
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string-here
AZURE_STORAGE_CONTAINER_NAME=publicprofile
AZURE_STORAGE_CUSTOM_DOMAIN=
