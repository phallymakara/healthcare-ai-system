# Frontend API Configuration
# For local development only — in Docker/production, Nginx handles routing automatically.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Portal URLs — set these to your actual deployed domains in each environment.
# They are used by src/utils/subdomain.ts to redirect between portals.
#
#   Patient portal  (main app)      → VITE_PATIENT_URL
#   Partner portal  (hospital mgmt) → VITE_PARTNER_URL
#
# Leave blank here; override via environment variables or Docker build args at deploy time.
VITE_PATIENT_URL=
VITE_PARTNER_URL=

# Local development example values (uncomment as needed):
# VITE_PATIENT_URL=http://localhost:5173
# VITE_PARTNER_URL=http://localhost:5174
